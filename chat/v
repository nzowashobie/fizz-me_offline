logger = logging.getLogger(__name__)

@csrf_exempt
@login_required
def clear_chat(request):
    if request.method == "POST":
        try:
            # Parse the JSON data from the request body
            data = json.loads(request.body)
            logger.info(f"Request data: {data}")  # Log the request data

            recipient_username = data.get("recipient_id")
            if not recipient_username:
                logger.error("Recipient ID is missing in the request.")
                return JsonResponse({"error": "Recipient ID is required."}, status=400)

            # Fetch the recipient user object
            try:
                recipient = CustomUser.objects.get(username=recipient_username)
            except CustomUser.DoesNotExist:
                logger.error(f"Recipient not found: {recipient_username}")
                return JsonResponse({"error": "Recipient not found."}, status=404)

            # Mark messages sent by the logged-in user as cleared
            Message.objects.filter(
                Q(sender=request.user, recipient=recipient)
            ).update(
                cleared_by_sender=True  # Mark as cleared by the sender
            )

            # Mark messages received by the logged-in user as cleared
            Message.objects.filter(
                Q(sender=recipient, recipient=request.user)
            ).update(
                cleared_by_recipient=True  # Mark as cleared by the recipient
            )

            logger.info(f"Chat cleared for user: {request.user.username} with recipient: {recipient_username}")
            return JsonResponse({"message": "Chat cleared successfully."}, status=200)

        except json.JSONDecodeError:
            logger.error("Invalid JSON data in the request.")
            return JsonResponse({"error": "Invalid JSON data."}, status=400)

        except Exception as e:
            logger.error(f"Error clearing chat: {str(e)}")
            return JsonResponse({"error": str(e)}, status=500)

    logger.error("Invalid request method.")
    return JsonResponse({"error": "Invalid request method."}, status=405)



