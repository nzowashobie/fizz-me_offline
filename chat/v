# Helper function to check if a user is blocked
def is_user_blocked(user, blocked_user):
    return BlockedUser.objects.filter(user=user, blocked_user=blocked_user).exists()



@csrf_exempt
def block_user(request):
    if request.method == "POST":
        user_to_block_id = request.POST.get("user_id")  # Use request.POST for form data
        try:
            user_to_block = CustomUser.objects.get(id=user_to_block_id)
            # Check if the user is already blocked
            if not BlockedUser.objects.filter(user=request.user, blocked_user=user_to_block).exists():
                BlockedUser.objects.create(user=request.user, blocked_user=user_to_block)
                return JsonResponse({"status": "success", "message": "User blocked successfully."})
            else:
                return JsonResponse({"status": "error", "message": "User is already blocked."}, status=400)
        except CustomUser.DoesNotExist:
            return JsonResponse({"status": "error", "message": "User not found."}, status=404)
    return JsonResponse({"status": "error", "message": "Invalid request method."}, status=400)


@csrf_exempt
def send_message(request):
    if request.method == "POST":
        data = json.loads(request.body)
        recipient_username = data.get("recipient")
        ciphertext = data.get("ciphertext")
        iv = data.get("iv")

        try:
            recipient = CustomUser.objects.get(username=recipient_username)
            sender = request.user

            # Save the encrypted message
            Message.objects.create(
                sender=sender,
                recipient=recipient,
                ciphertext=ciphertext,
                iv=iv,
            )

            return JsonResponse({"status": "success"})
        except CustomUser.DoesNotExist:
            return JsonResponse({"status": "error", "message": "Recipient not found"}, status=404)
    return JsonResponse({"status": "error", "message": "Invalid request method"}, status=400)

