def mark_messages_as_read(request):
    sender_username = request.GET.get('sender')  # Get the sender's username
    try:
        sender = User.objects.get(username=sender_username)
    except User.DoesNotExist:
        return JsonResponse({"error": "Sender does not exist"}, status=404)

    # Mark messages as read for the current user (recipient) from the sender
    Message.objects.filter(
        recipient=request.user,  # Current user is the recipient
        sender=sender,          # Sender is the other user
        is_read=False           # Only mark unread messages
    ).update(is_read=True)

    return JsonResponse({"status": "success"})

