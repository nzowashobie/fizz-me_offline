def get_unread_message_count(request):
    """
    Fetch the unread message count for the current user from each sender.
    """
    if not request.user.is_authenticated:
        return JsonResponse({"error": "User not authenticated"}, status=401)

    # Get all users except the current user
    users = User.objects.exclude(id=request.user.id)

    # Fetch unread message count for each user
    unread_counts = {}
    for user in users:
        count = Message.objects.filter(
            recipient=request.user,  # Messages sent to the current user
            sender=user,              # Messages from this specific user
            is_read=False             # Only unread messages
        ).count()
        unread_counts[user.username] = count

    return JsonResponse(unread_counts)


