@csrf_exempt
def upload_attachments(request):
    if request.method == "POST":
        uploaded_files = request.FILES.getlist("files")
        saved_files = []

        for file in uploaded_files:
            try:
                # Validate file size (e.g., 10MB limit)
                if file.size > 10 * 1024 * 1024:  # 10MB
                    raise ValueError("File size exceeds the limit (10MB).")

                # Validate file type (e.g., allow only PDF, images, and text files)
                allowed_types = ["application/pdf", "image/jpeg", "image/png", "text/plain"]
                if file.content_type not in allowed_types:
                    raise ValueError("File type not allowed.")

                # Create an Attachment object (without associating it with a message)
                attachment = Attachment(
                    file=file,
                    file_type=file.content_type,  # Set the file_type
                )
                attachment.save()  # This will encrypt the file automatically

                # Get the URL of the saved file
                file_url = default_storage.url(attachment.file.name)

                saved_files.append({
                    "id": attachment.id,  # Include the attachment ID
                    "url": file_url,
                    "name": file.name,
                    "type": file.content_type,
                })
            except Exception as e:
                # Log the error and continue processing other files
                print(f"Error uploading file {file.name}: {str(e)}")
                saved_files.append({
                    "error": f"Failed to upload {file.name}: {str(e)}"
                })

        return JsonResponse(saved_files, safe=False)
    return JsonResponse({"error": "Invalid request method"}, status=405)


def get_attachments(request, message_id=None):
    if request.method == "GET":
        try:
            if message_id:
                # Fetch attachments for a specific message
                attachments = Attachment.objects.filter(message_id=message_id)
            else:
                # Fetch all attachments
                attachments = Attachment.objects.all()

            if not attachments.exists():
                return JsonResponse({"error": "No attachments found"}, status=404)

            # Serialize attachments data
            attachments_data = []
            for attachment in attachments:
                attachments_data.append({
                    "id": attachment.id,  # Include the attachment ID
                    "url": attachment.file.url,
                    "name": os.path.basename(attachment.file.name),
                    "type": attachment.file_type,
                })

            return JsonResponse(attachments_data, safe=False)
        except Exception as e:
            return JsonResponse({"error": str(e)}, status=500)
    return JsonResponse({"error": "Invalid request method"}, status=405)


