    // Handle file selection (trigger file input window when "Select Files" is clicked)
    document.addEventListener("DOMContentLoaded", function () {
      const fileUploadButton = document.querySelector("#id_file_upload_button");
      const fileInput = document.querySelector("#id_file_input");
    
      if (fileUploadButton && fileInput) {
        // Ensure the event listener is added only once
        if (!fileUploadButton.hasAttribute("data-listener-added")) {
          fileUploadButton.addEventListener("click", function (e) {
            console.log("File upload button clicked"); // Debugging
            e.preventDefault(); // Prevent default behavior
            e.stopPropagation(); // Prevent event bubbling
            fileInput.click(); // Trigger the file input window
          });
    
          // Mark the button to indicate the listener has been added
          fileUploadButton.setAttribute("data-listener-added", "true");
        }
      }
    });
    
    // Handle file input change (upload files to the server and preview them)
    document.querySelector("#id_file_input").addEventListener("change", async function (e) {
      const files = e.target.files;
      console.log("Files selected:", files); // Log the files
    
      const chatBox = document.querySelector("#id_chat_item_container");
      if (!chatBox) {
        console.error("#id_chat_item_container element not found!");
        return;
      }
    
      if (files.length > 0) {
        const formData = new FormData();
        Array.from(files).forEach((file) => {
          formData.append("files", file); // Append each file to the FormData object
        });
    
        try {
          // Upload files to the server
          const response = await fetch("/api/upload-attachments/", {
            method: "POST",
            body: formData,
            headers: {
              "X-CSRFToken": "{{ csrf_token }}", // Include CSRF token for security
            },
          });
    
          if (!response.ok) {
            throw new Error("Failed to upload files");
          }
    
          const savedFiles = await response.json();
          console.log("Files uploaded:", savedFiles);
    
          // Render the previews
          savedFiles.forEach((file) => {
            renderAttachmentPreview(file.url, file.name, file.type);
          });
        } catch (error) {
          console.error("Error uploading files:", error);
          alert("Failed to upload files. Please try again.");
        }
      }
    });
    
