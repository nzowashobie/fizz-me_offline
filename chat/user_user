// Function to handle zooming images and videos
function handleZoom(element) {
  element.addEventListener("click", () => {
    if (element.classList.contains("zoomed")) {
      // If already zoomed, return to normal size
      element.classList.remove("zoomed");
      element.style.position = "static";
      element.style.top = "auto";
      element.style.left = "auto";
      element.style.width = "auto";
      element.style.height = "auto";
      element.style.transform = "none";
      element.style.cursor = "pointer";
      document.body.style.overflow = "auto"; // Re-enable scrolling
    } else {
      // Zoom the element to fill the screen while maintaining aspect ratio
      element.classList.add("zoomed");
      element.style.position = "fixed";
      element.style.top = "50%";
      element.style.left = "50%";
      element.style.transform = "translate(-50%, -50%)";
      element.style.maxWidth = "100%";
      element.style.maxHeight = "100%";
      element.style.width = "auto";
      element.style.height = "auto";
      element.style.cursor = "zoom-out";
      document.body.style.overflow = "hidden"; // Disable scrolling while zoomed
    }
  });

  // Handle double-tap for mobile devices
  let lastTap = 0;
  element.addEventListener("touchend", (event) => {
    const currentTime = new Date().getTime();
    const tapLength = currentTime - lastTap;
    if (tapLength < 300 && tapLength > 0) {
      // Double-tap detected
      event.preventDefault();
      element.click(); // Trigger the zoom functionality
    }
    lastTap = currentTime;
  });
}
