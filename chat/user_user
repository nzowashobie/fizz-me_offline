            // Add zoom functionality
            handleZoom(video);

            attachmentElement.appendChild(video);
          } else if (attachment.file_type.startsWith("audio/")) {
            const audio = document.createElement("audio");
            audio.src = attachment.file_url;
            audio.controls = true;
            audio.style.width = "100%";
            attachmentElement.appendChild(audio);
          } else {
            // For other file types (e.g., PDF, documents), show a file icon and name
            const fileLink = document.createElement("div");
