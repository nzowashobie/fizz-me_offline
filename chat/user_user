/* Zoom Styles */
.attachment img,
.attachment video {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  border: 1px solid #ddd;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.attachment img:hover,
.attachment video:hover {
  transform: scale(1.05);
}

.attachment img.zoomed,
.attachment video.zoomed {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  z-index: 10000;
  background-color: rgba(0, 0, 0, 0.9);
  border-radius: 0;
  border: none;
  cursor: zoom-out;
}

