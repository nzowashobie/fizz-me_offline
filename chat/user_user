.custom-notification {
  position: fixed;
  top: 20px;
  right: 20px;
  background-color: #333;
  color: #fff;
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  z-index: 10000;
  display: none; /* Hidden by default */
  animation: slideIn 0.5s ease-out;
}

.notification-content {
  display: flex;
  align-items: center;
  gap: 10px;
}

.notification-icon {
  width: 24px;
  height: 24px;
}

/* Animation for sliding in */
@keyframes slideIn {
  from {
    transform: translateX(100%);
  }
  to {
    transform: translateX(0);
  }
}

/* Animation for sliding out */
@keyframes slideOut {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(100%);
  }
}

  </style>
</head>
<body>
  <!-- Side navigation -->
  <div class="side-navigation" id="side-navigation">
    <div class="side-navigation-header">
      <button class="toggle-button" id="toggle-button">☰</button>
    </div>
    <div class="conversation-list" id="conversation-list">
      {% for user in users %}
        <div class="conversation-item" data-recipient="{{ user.username }}">
          <img class="profile-picture" src="{{ user.profile.profile_picture.url }}" alt="{{ user.username }}">
          <span>{{ user.username }}</span>
          <span class="unread-count" id="unread-count-{{ user.username }}">0</span>
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Chat container -->
  <div class="chat-header">
    <button class="show-user-list-button" id="show-user-list-button">👥</button>
    <div class="user-profile" id="user-profile">
      <img class="profile-picture" src="{{ request.user.profile.profile_picture.url }}" alt="{{ request.user.username }}">
      <span>{{ request.user.username }}</span>
    </div>
    <!-- Add selected user's name here -->
    <div id="selected-user-name" style="margin-left: 10px; font-weight: bold;"></div>
    <!-- User Actions Button -->
    <button id="user-actions-button">⚙️</button>
    {% if request.user.is_authenticated %}
      <a href="{% url 'logout-user' %}" class="logout-link">
        <i class="fas fa-sign-out-alt"></i> <!-- Font Awesome logout icon -->
      </a>
    {% else %}
      <a href="{% url 'login-user' %}" class="login-link">
        <i class="fas fa-sign-in-alt"></i> Login <!-- Font Awesome login icon -->
      </a>
    {% endif %}
  </div>
  

    <!-- Chat box -->
    <div class="chat-box" id="id_chat_item_container"></div>
  
    <!-- Chat input -->
    <div class="chat-input">
      <button id="id_file_upload_button">
        📎
      </button>
      <textarea id="id_message_send_input" placeholder="Type a message..."></textarea>
      <input type="file" id="id_file_input" multiple style="display: none;">
      <button id="id_message_send_button">
