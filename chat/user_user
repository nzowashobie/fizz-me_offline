            fileLink.style.display = "flex";
            fileLink.style.alignItems = "center";
            fileLink.style.padding = "5px";
            fileLink.style.border = "1px solid #ddd";
            fileLink.style.borderRadius = "8px";
            fileLink.style.backgroundColor = "#f9f9f9";
