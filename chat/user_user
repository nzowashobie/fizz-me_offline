function renderMessage(message) {
  const chatBox = document.querySelector("#id_chat_item_container");

  // Create a container for the message
  const messageContainer = document.createElement("div");
  messageContainer.classList.add(
    message.sender === "{{ request.user.username }}" ? "user-message-container" : "other-message-container"
  );

  // Create the message element
  const messageElement = document.createElement("div");
  messageElement.classList.add("chat-message");
  messageElement.classList.add(
    message.sender === "{{ request.user.username }}" ? "user-message" : "other-message"
  );

  // Create message content
  const messageContent = document.createElement("div");
  messageContent.classList.add("message-content");

  // Add message text
  const messageText = document.createElement("div");
  messageText.classList.add("message-text");
  messageText.textContent = message.message;
  messageContent.appendChild(messageText);

  // Add attachments (if any)
  if (message.attachments && message.attachments.length > 0) {
    const attachmentContainer = document.createElement("div");
    message.attachments.forEach((attachment) => {
      const attachmentElement = document.createElement("div");
      attachmentElement.classList.add("attachment");

      if (attachment.file_type.startsWith("image/")) {
        const img = document.createElement("img");
        img.src = attachment.file_url;
        img.style.maxWidth = "100%";
        img.style.height = "auto";
        img.style.borderRadius = "8px";
        img.style.border = "1px solid #ddd";
        img.style.cursor = "pointer";

        // Add zoom functionality
        handleZoom(img);

        attachmentElement.appendChild(img);
      } else if (attachment.file_type.startsWith("video/")) {
        const video = document.createElement("video");
        video.src = attachment.file_url;
        video.controls = true;
        video.style.maxWidth = "100%";
        video.style.height = "auto";
        video.style.borderRadius = "8px";
        video.style.border = "1px solid #ddd";
        video.style.cursor = "pointer";

        // Add zoom functionality
        handleZoom(video);

        attachmentElement.appendChild(video);
      }

      attachmentContainer.appendChild(attachmentElement);
    });

    messageContent.appendChild(attachmentContainer);
  }

  // Add message content to message element
  messageElement.appendChild(messageContent);

  // Add message element to the container
  messageContainer.appendChild(messageElement);

  // Add message container to chat box
  chatBox.appendChild(messageContainer);

  // Auto-scroll to the bottom
  chatBox.scrollTop = chatBox.scrollHeight;
}
